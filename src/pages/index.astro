---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Only what the public repositories show.
const skills = ['ROS 2', 'MoveIt 2', 'Gazebo', 'ros2_control', 'URDF', 'Python', 'CadQuery', '3D printing design', 'GitHub Actions', 'Git'];
---
<Base>
  <section class="hero" aria-label="Introduction">
    <p class="eyebrow label">Computer Science · Estácio · Brazil</p>
    <h1><span>Daniel</span> <span class="accent">Dos Santos Da Silva</span></h1>
    <div class="summary">
      <p>A Computer Science student in Brazil who designs and builds machines from scratch.</p>
      <p>Hardware costs money, so my machines live in simulation for now, but every part is designed to be built for real.</p>
    </div>
    <ul class="facts-row">
      <li><span class="value">ROS 2</span><span class="label">MoveIt 2 · Gazebo</span></li>
      <li><span class="value">CadQuery</span><span class="label">CAD written in Python</span></li>
      <li><span class="value">Brazil</span><span class="label">On-site or remote</span></li>
    </ul>
    <a class="button solid" href="#projects">View projects <span aria-hidden="true">↓</span></a>
  </section>

  <section id="projects" class="section" aria-labelledby="projects-title">
    <div class="section-head">
      <h2 id="projects-title">Selected work</h2>
    </div>
    <ul class="work">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </ul>
  </section>

  <section id="about" class="section" aria-labelledby="about-title">
    <div class="section-head">
      <h2 id="about-title">About me</h2>
    </div>
    <div class="about-grid">
      <div class="about-text">
        <p>I'm a Computer Science student at Estácio, in Brazil. I love taking a project all the way from the first idea to something that actually works. Robots are where I started, but I want to go further and build all kinds of things, like drones, motors and even rockets.</p>
        <p>Hardware costs money, so my machines live in simulation for now, but every part is designed to be built for real. I model the parts in Python with CadQuery, ready to be 3D printed in PLA, and the same model gives the simulation its meshes, masses and inertias.</p>
        <p>I check the simulation against numbers I can trust. On my robot arm, the kinematics match the CAD solids within 1.1e-13 mm and the joint torques in Gazebo match the hand calculation within 0.15 %. My main stack is ROS 2, Python, Gazebo and MoveIt 2. My favorite tools are CadQuery for CAD, Obsidian for my notes and Claude Code as my pair programmer.</p>
      </div>
      <div class="skills">
        <h3>Core skills</h3>
        <ul>{skills.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="contact-box">
      <div>
        <h2 id="contact-title">Contact</h2>
        <p>I'm open to on-site or remote roles, in Brazil or abroad.</p>
      </div>
      <ul class="contact-list">
        <li><a class="button solid" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="button" href={site.linkedin}>LinkedIn</a></li>
        <li><a class="button" href={site.github}>GitHub</a></li>
        {site.resume && <li><a class="button" href={site.resume}>Resume (PDF)</a></li>}
      </ul>
    </div>
  </section>
</Base>
