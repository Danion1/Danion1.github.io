---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number; // position on the page, shown as 01, 02...
}

const { project, index } = Astro.props;
const { title, summary, tags, video, poster, cover, coverAlt, status, note } = project.data;
const comingNext = status === 'coming-next';
const href = `/projects/${project.id}/`;
const num = String(index + 1).padStart(2, '0');
---
{comingNext ? (
  <li>
    <article class="card soon">
      <div class="num" aria-hidden="true">{num}</div>
      {note && <span class:list={['badge', 'label', { planned: note === 'Planned' }]}>{note}</span>}
      <h3>{title}</h3>
      <p>{summary}</p>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
      <span class="when label">Coming soon</span>
    </article>
  </li>
) : (
  <li class="featured">
    <article class="card linked featured">
      {(video || cover) && (
        <div class="media">
          {video ? (
            <video muted playsinline loop autoplay preload="metadata" poster={poster} aria-hidden="true">
              <source src={video} type="video/mp4" />
            </video>
          ) : (
            <img src={cover} alt={coverAlt ?? ''} loading="lazy" decoding="async" style="object-fit:contain;padding:12px" />
          )}
        </div>
      )}
      <div class="body">
        <div class="num" aria-hidden="true">{num}</div>
        <h3><a href={href}>{title}</a></h3>
        <p>{summary}</p>
        {note && <p class="status label">{note}</p>}
        {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
        <span class="go label" aria-hidden="true">View project</span>
      </div>
    </article>
  </li>
)}
