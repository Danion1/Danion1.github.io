---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, tags, cover, coverAlt, video, poster, status, note } = project.data;
const comingNext = status === 'coming-next';
const href = `/projects/${project.id}/`;
---
{comingNext ? (
  <li class="project coming">
    <div>
      <p class="status">Coming next</p>
      <h3>{title}</h3>
      <p class="summary">{summary}</p>
    </div>
  </li>
) : (
  <li class="project">
    {/* The media is a second link to the same page: hidden from screen readers and the tab order, the title link is the one they use. */}
    {(video || cover) && (
      <a class="project-media" href={href} tabindex="-1" aria-hidden="true">
        {video ? (
          <video class="motion" muted playsinline loop autoplay preload="metadata" poster={poster}>
            <source src={video} type="video/mp4" />
          </video>
        ) : (
          <img class="cad" src={cover} alt={coverAlt ?? ''} loading="lazy" decoding="async" />
        )}
      </a>
    )}
    <div>
      {tags.length > 0 && <p class="stack">{tags.join(', ')}</p>}
      <h3><a href={href}>{title}</a></h3>
      <p class="summary">{summary}</p>
      {note && <p class="status">{note}</p>}
    </div>
  </li>
)}
